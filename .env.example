# ==============================================================================
# Legal Metrology Inspection Assistant — Environment Configuration
# ==============================================================================
# NOTE: NO PAID API KEYS ARE REQUIRED to run this project!
# - Demo scenarios use the built-in deterministic Mock OCR engine.
# - Real user uploads & camera scans use local Tesseract.js (free & runs in Node.js).
# ==============================================================================

# Port for the Express backend API
PORT=3001

# Default OCR engine ('mock' for demo testing, 'tesseract' for real OCR)
# Note: The server automatically uses Mock for demo scenarios and Tesseract for real uploads.
OCR_MODE=mock

# (Optional - Future Phase): If integrating cloud LLM/Vision APIs in the future:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# PADDLE_OCR_URL=
