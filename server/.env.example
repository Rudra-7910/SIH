# Legal Metrology Inspection Assistant — Backend Environment Configuration

# Server Port
PORT=3001

# OCR Mode: 'mock' (default for demo scenarios) or 'real'
OCR_MODE=mock

# Extraction Provider: 'heuristic' (default, regex keyword matching) or 'gemini' (LLM fallback)
EXTRACTION_PROVIDER=heuristic

# Optional Gemini API Key (get free at https://aistudio.google.com)
# When set and EXTRACTION_PROVIDER=gemini, enables Layer 2 LLM extraction fallback for noisy/unstructured images
GEMINI_API_KEY=
